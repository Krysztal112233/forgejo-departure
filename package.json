{
  "name": "forgejo-departure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Departure-board theme for Forgejo — Tailwind v4 tokens + Vite build, validated in a container",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup-config.mjs",
    "build": "vite build",
    "watch": "vite build --watch",
    "up": "podman-compose up -d",
    "down": "podman-compose down",
    "logs": "podman-compose logs -f forgejo"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
